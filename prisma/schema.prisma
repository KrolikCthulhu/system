generator client {
    provider = "prisma-client-js"
    output   = "./__generated__"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    ADMIN
    USER
}

model User {
    id                      String                   @id @default(uuid()) @db.Uuid
    email                   String                   @unique
    username                String                   @unique
    displayUsername         String
    passwordHash            String
    role                    UserRole                 @default(USER)
    isActive                Boolean                  @default(true)
    isEmailVerified         Boolean                  @default(false)
    authSessions            AuthSession[]
    emailVerificationTokens EmailVerificationToken[]
    createdAt               DateTime                 @default(now())
    updatedAt               DateTime                 @updatedAt

    @@map("users")
}

model AuthSession {
    id           String        @id @default(uuid()) @db.Uuid
    userId       String        @db.Uuid
    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash    String
    familyId     String        @db.Uuid
    parentId     String?       @db.Uuid
    parent       AuthSession?  @relation("AuthSessionRotation", fields: [parentId], references: [id], onDelete: SetNull)
    children     AuthSession[] @relation("AuthSessionRotation")
    expiresAt    DateTime
    revokedAt    DateTime?
    replacedById String?       @db.Uuid
    ipAddress    String?
    userAgent    String?
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    @@index([userId])
    @@index([familyId])
    @@index([expiresAt])
    @@index([parentId])
    @@map("auth_sessions")
}

model EmailVerificationToken {
    id        String    @id @default(uuid()) @db.Uuid
    userId    String    @db.Uuid
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash String
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())

    @@index([userId])
    @@index([expiresAt])
    @@map("email_verification_tokens")
}

model SkillCategory {
    id          String   @id @default(uuid()) @db.Uuid
    name        String
    description String?
    isActive    Boolean  @default(true) @map("is_active")
    sortOrder   Int      @default(0) @map("sort_order")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")
    skills      Skill[]

    @@index([isActive, sortOrder])
    @@map("skill_categories")
}

model SkillLevel {
    id                    String   @id @default(uuid()) @db.Uuid
    level                 Int      @unique
    name                  String
    canRoll               Boolean  @default(true) @map("can_roll")
    successMin            Int?     @map("success_min")
    doubleSuccessMin      Int?     @map("double_success_min")
    ignoreOnesCount       Int      @default(0) @map("ignore_ones_count")
    expectedSuccessPerDie Decimal  @default(0) @map("expected_success_per_die") @db.Decimal(8, 4)
    ruleText              String?  @map("rule_text")
    isActive              Boolean  @default(true) @map("is_active")
    sortOrder             Int      @default(0) @map("sort_order")
    createdAt             DateTime @default(now()) @map("created_at")
    updatedAt             DateTime @updatedAt @map("updated_at")

    @@index([isActive, sortOrder])
    @@map("skill_levels")
}

model Skill {
    id                    String        @id @default(uuid()) @db.Uuid
    name                  String
    shortName             String?       @map("short_name")
    categoryId            String        @map("category_id") @db.Uuid
    category              SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    description           String?
    maxLevel              Int           @default(6) @map("max_level")
    defaultLevel          Int           @default(0) @map("default_level")
    usesDefaultLevelRules Boolean       @default(true) @map("uses_default_level_rules")
    isActive              Boolean       @default(true) @map("is_active")
    sortOrder             Int           @default(0) @map("sort_order")
    createdAt             DateTime      @default(now()) @map("created_at")
    updatedAt             DateTime      @updatedAt @map("updated_at")

    @@index([categoryId])
    @@index([categoryId, isActive, sortOrder])
    @@map("skills")
}

model Attribute {
    id              String           @id @default(uuid()) @db.Uuid
    name            String
    description     String?
    isActive        Boolean          @default(true) @map("is_active")
    sortOrder       Int              @default(0) @map("sort_order")
    createdAt       DateTime         @default(now()) @map("created_at")
    updatedAt       DateTime         @updatedAt @map("updated_at")
    characteristics Characteristic[]

    @@index([isActive, sortOrder])
    @@map("attributes")
}

model Characteristic {
    id           String    @id @default(uuid()) @db.Uuid
    name         String
    attributeId  String    @map("attribute_id") @db.Uuid
    attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
    description  String?
    minValue     Int       @default(0) @map("min_value")
    maxValue     Int       @default(10) @map("max_value")
    defaultValue Int       @default(0) @map("default_value")
    isActive     Boolean   @default(true) @map("is_active")
    sortOrder    Int       @default(0) @map("sort_order")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")

    @@index([attributeId])
    @@index([attributeId, isActive, sortOrder])
    @@map("characteristics")
}
