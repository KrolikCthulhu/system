model Creature {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String         @unique @default(cuid())
  name      String         @unique
  typeId    String         @map("type_id") @db.Uuid
  type      CreatureType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  tiers     CreatureTier[]
  isActive  Boolean        @default(true) @map("is_active")
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([typeId, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("creatures")
}

model CreatureTier {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatureId      String                       @map("creature_id") @db.Uuid
  creature        Creature                     @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  tier            Int
  name            String
  hp              Int                          @default(1)
  armorPresetId   String?                      @map("armor_preset_id") @db.Uuid
  armorPreset     ArmorPreset?                 @relation(fields: [armorPresetId], references: [id], onDelete: SetNull)
  skills          CreatureTierSkill[]
  characteristics CreatureTierCharacteristic[]
  isActive        Boolean                      @default(true) @map("is_active")
  sortOrder       Int                          @default(0) @map("sort_order")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  @@unique([creatureId, tier])
  @@index([armorPresetId])
  @@index([creatureId, sortOrder])
  @@map("creature_tiers")
}

model CreatureTierSkill {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatureTierId String       @map("creature_tier_id") @db.Uuid
  creatureTier   CreatureTier @relation(fields: [creatureTierId], references: [id], onDelete: Cascade)
  skillId        String       @map("skill_id") @db.Uuid
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Restrict)
  level          Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([creatureTierId, skillId])
  @@index([skillId])
  @@map("creature_tier_skills")
}

model CreatureTierCharacteristic {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatureTierId   String         @map("creature_tier_id") @db.Uuid
  creatureTier     CreatureTier   @relation(fields: [creatureTierId], references: [id], onDelete: Cascade)
  characteristicId String         @map("characteristic_id") @db.Uuid
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Restrict)
  value            Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([creatureTierId, characteristicId], map: "creature_tier_characteristics_creature_tier_id_characteristic_i")
  @@index([characteristicId])
  @@map("creature_tier_characteristics")
}

model ProgressionPreset {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String                @unique @default(cuid())
  name        String                @unique
  description String?
  kind        ProgressionPresetKind
  config      Json
  isActive    Boolean               @default(true) @map("is_active")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@index([kind, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("progression_presets")
}

model Attribute {
  id                   String           @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  systemValueId        String           @unique @map("system_value_id") @db.Uuid
  systemValue          SystemValue      @relation(fields: [systemValueId], references: [id], onDelete: Restrict)
  poolPenaltyValueId   String?          @map("pool_penalty_value_id") @db.Uuid
  poolPenaltyValue     SystemValue?     @relation("AttributePoolPenaltyValue", fields: [poolPenaltyValueId], references: [id], onDelete: SetNull)
  availablePoolValueId String?          @unique @map("available_pool_value_id") @db.Uuid
  availablePoolValue   SystemValue?     @relation("AttributeAvailablePoolValue", fields: [availablePoolValueId], references: [id], onDelete: SetNull)
  isActive             Boolean          @default(true) @map("is_active")
  sortOrder            Int              @default(0) @map("sort_order")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  characteristics      Characteristic[]

  @@index([isActive, sortOrder])
  @@index([poolPenaltyValueId])
  @@map("attributes")
}

model Characteristic {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String
  attributeId                  String                        @map("attribute_id") @db.Uuid
  attribute                    Attribute                     @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  description                  String?
  minValue                     Int                           @default(0) @map("min_value")
  maxValue                     Int                           @default(10) @map("max_value")
  defaultValue                 Int                           @default(0) @map("default_value")
  systemValueId                String                        @unique @map("system_value_id") @db.Uuid
  systemValue                  SystemValue                   @relation(fields: [systemValueId], references: [id], onDelete: Restrict)
  rollSkills                   Skill[]                       @relation("SkillRollCharacteristic")
  creatureTierValues           CreatureTierCharacteristic[]
  weaponAttackProfiles         WeaponAttackProfile[]         @relation("WeaponProfileCharacteristic")
  weaponTemplateAttackProfiles WeaponTemplateAttackProfile[] @relation("WeaponTemplateProfileCharacteristic")
  isActive                     Boolean                       @default(true) @map("is_active")
  sortOrder                    Int                           @default(0) @map("sort_order")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")

  @@index([attributeId])
  @@index([attributeId, isActive, sortOrder])
  @@map("characteristics")
}

model SystemValue {
  id               String               @id @default(uuid()) @db.Uuid
  slug             String               @unique @default(cuid())
  name             String
  description      String?
  primaryOwnerType SystemValueOwnerType @map("primary_owner_type")
  primaryOwnerId   String?              @map("primary_owner_id") @db.Uuid
  displaySection   String?              @map("display_section")
  calculationGraph Json?                @map("calculation_graph")
  isSystemManaged  Boolean              @default(false) @map("is_system_managed")
  isActive         Boolean              @default(true) @map("is_active")
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  skills                         Skill[]                  @relation("SkillSystemValue")
  attributes                     Attribute[]
  poolPenaltyAttributes          Attribute[]              @relation("AttributePoolPenaltyValue")
  availablePoolAttributes        Attribute[]              @relation("AttributeAvailablePoolValue")
  characteristics                Characteristic[]
  links                          SystemValueLink[]
  spellMechanicParameterDefaults SpellMechanicParameter[]

  @@index([primaryOwnerType, primaryOwnerId])
  @@index([isActive, sortOrder])
  @@map("system_values")
}

model SystemValueLink {
  id            String               @id @default(uuid()) @db.Uuid
  systemValueId String               @map("system_value_id") @db.Uuid
  systemValue   SystemValue          @relation(fields: [systemValueId], references: [id], onDelete: Cascade)
  targetType    SystemValueOwnerType @map("target_type")
  targetId      String?              @map("target_id") @db.Uuid
  label         String?
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@unique([systemValueId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([systemValueId])
  @@map("system_value_links")
}

model CharacterSheetSandboxDraft {
  key         String   @id
  inputValues Json     @map("input_values")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("character_sheet_sandbox_drafts")
}
