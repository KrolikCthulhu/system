model Creature {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String                       @unique @default(cuid())
  name               String                       @unique
  typeId             String                       @map("type_id") @db.Uuid
  type               CreatureType                 @relation(fields: [typeId], references: [id], onDelete: Restrict)
  anatomySchemeId    String?                      @map("anatomy_scheme_id") @db.Uuid
  anatomyScheme      AnatomyScheme?               @relation(fields: [anatomySchemeId], references: [id], onDelete: SetNull)
  actions            Json                         @default("[]")
  tiers              CreatureTier[]
  anatomyZones       CreatureAnatomyZone[]
  naturalAttackLinks CreatureNaturalAttack[]
  combatParticipants CombatEncounterParticipant[]
  isActive           Boolean                      @default(true) @map("is_active")
  sortOrder          Int                          @default(0) @map("sort_order")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@index([typeId, isActive, sortOrder])
  @@index([anatomySchemeId])
  @@index([isActive, sortOrder])
  @@map("creatures")
}

model CreatureNaturalAttack {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatureId      String        @map("creature_id") @db.Uuid
