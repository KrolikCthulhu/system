  attackOverrides    Json                         @default("[]") @map("attack_overrides")
  abilities          Json                         @default("[]")
  actions            Json                         @default("[]")
  actionOverrides    Json                         @default("[]") @map("action_overrides")
  targetSelection    Json                         @default("{}") @map("target_selection")
  skills             CreatureTierSkill[]
  characteristics    CreatureTierCharacteristic[]
