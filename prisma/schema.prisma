  name      String   @unique
  category  String   @default("Без категории")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  weaponAttackProfileLinks         WeaponAttackProfileIntent[]
  weaponTemplateAttackProfileLinks WeaponTemplateAttackProfileIntent[]

  @@index([category, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("combat_intents")
}

model WeaponTemplateAttackProfileIntent {
