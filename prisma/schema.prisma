generator client {
  provider = "prisma-client-js"
  output   = "./__generated__"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum CampaignMemberRole {
  GM
  PLAYER
}

enum CampaignMemberStatus {
  INVITED
  ACTIVE
  LEFT
}

enum PlayerCharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CombatEncounterStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum CombatEncounterParticipantKind {
  PLAYER_CHARACTER
  CREATURE
}

enum SystemValueOwnerType {
  ATTRIBUTE
  CHARACTERISTIC
  SKILL
  ROLL_CONSEQUENCE
  MANUAL
}

enum MagicWordType {
  ACTION
  ESSENCE
  GESTURE
  MODIFIER
}

enum AreaShapeKind {
  POINT
  LINE
  PLANE
  CONE
  SPHERE
  CUBE
  CYLINDER
  RING
}

enum SpellStatus {
  DRAFT
  TESTING
  READY
}

enum SpellMechanicParameterKind {
  TARGET
  SKILL
  NUMBER
  FORMULA
  DAMAGE_TYPE
  CONDITION
  SYSTEM_VALUE
  TEXT
}

enum SpellMechanicParameterDefaultMode {
  EMPTY
  STATIC
  FROM_MAGIC_WORD
}

enum SpellMechanicNumericRole {
  DAMAGE
  RANGE
  DURATION
  AREA
  TARGET_COUNT
  CUSTOM
}

enum SpellMechanicParameterScope {
  CASTER
  TARGET
  SPELL
  EFFECT
  ENVIRONMENT
}

enum SpellMechanicActionKind {
  ROLL
  CHECK
  COMPARISON
  CALCULATION
  BRANCH
  EFFECT_SCALE
  VALUE_CHANGE
  CONDITION_ADD
  CONDITION_REMOVE
  TEXT
  CUSTOM
}

enum ProgressionPresetKind {
  LINEAR
  STEP
  QUADRATIC
  SQUARE_ROOT
  LOGARITHMIC
  SATURATION
  PERCENT
}

enum WeaponAttackProfileKind {
  MELEE
  RANGED
}

enum AnatomyZoneKind {
  MAIN
  TARGETED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  username                String                   @unique
  displayUsername         String
  passwordHash            String
  role                    UserRole                 @default(USER)
  isActive                Boolean                  @default(true)
  isEmailVerified         Boolean                  @default(false)
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  ownedCampaigns          Campaign[]               @relation("CampaignOwner")
  campaignMemberships     CampaignMember[]
  playerCharacters        PlayerCharacter[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@map("users")
}

model Campaign {
  id                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  description                String?
  ownerId                    String            @map("owner_id") @db.Uuid
  owner                      User              @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                    CampaignMember[]
  characters                 PlayerCharacter[]
  encounters                 CombatEncounter[]
  combatActionResolutionMode String            @default("delayed") @map("combat_action_resolution_mode")
  isActive                   Boolean           @default(true) @map("is_active")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([isActive, updatedAt])
  @@map("campaigns")
}

model CampaignMember {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String               @map("campaign_id") @db.Uuid
  campaign    Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String               @map("user_id") @db.Uuid
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CampaignMemberRole   @default(PLAYER)
  status      CampaignMemberStatus @default(INVITED)
  invitedById String?              @map("invited_by_id") @db.Uuid
  invitedAt   DateTime             @default(now()) @map("invited_at")
  joinedAt    DateTime?            @map("joined_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId, status])
  @@map("campaign_members")
}

model PlayerCharacter {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId         String                       @map("campaign_id") @db.Uuid
  campaign           Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ownerUserId        String                       @map("owner_user_id") @db.Uuid
  ownerUser          User                         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name               String
  sheetInputValues   Json                         @default("{}") @map("sheet_input_values")
  combatParticipants CombatEncounterParticipant[]
  status             PlayerCharacterStatus        @default(DRAFT)
  isActive           Boolean                      @default(true) @map("is_active")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@index([campaignId, status])
  @@index([ownerUserId])
  @@index([campaignId, ownerUserId])
  @@map("player_characters")
}

model CombatEncounter {
  id              String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId      String                                @map("campaign_id") @db.Uuid
  campaign        Campaign                              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name            String
  status          CombatEncounterStatus                 @default(DRAFT)
  participants    CombatEncounterParticipant[]
  conditions      CombatEncounterParticipantCondition[]
  conditionLinks  CombatEncounterConditionLink[]
  events          CombatEncounterEvent[]
  defenseRequests CombatEncounterDefenseRequest[]
  declaredActions CombatEncounterDeclaredAction[]
  isActive        Boolean                               @default(true) @map("is_active")
  createdAt       DateTime                              @default(now()) @map("created_at")
  updatedAt       DateTime                              @updatedAt @map("updated_at")

  @@index([campaignId, status])
  @@index([campaignId, isActive, updatedAt])
  @@map("combat_encounters")
}

model CombatEncounterParticipant {
  id                    String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId           String                                @map("encounter_id") @db.Uuid
  encounter             CombatEncounter                       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  kind                  CombatEncounterParticipantKind
  playerCharacterId     String?                               @map("player_character_id") @db.Uuid
  playerCharacter       PlayerCharacter?                      @relation(fields: [playerCharacterId], references: [id], onDelete: SetNull)
  creatureId            String?                               @map("creature_id") @db.Uuid
  creature              Creature?                             @relation(fields: [creatureId], references: [id], onDelete: SetNull)
  creatureTierId        String?                               @map("creature_tier_id") @db.Uuid
  creatureTier          CreatureTier?                         @relation(fields: [creatureTierId], references: [id], onDelete: SetNull)
  sceneName             String                                @map("scene_name")
  currentHealth         Int                                   @default(0) @map("current_health")
  currentPotential      Int                                   @default(0) @map("current_potential")
  initiative            Int?
  conditions            CombatEncounterParticipantCondition[]
  sourceConditionLinks  CombatEncounterConditionLink[]        @relation("CombatEncounterConditionLinkSource")
  targetConditionLinks  CombatEncounterConditionLink[]        @relation("CombatEncounterConditionLinkTarget")
  actorDefenseRequests  CombatEncounterDefenseRequest[]       @relation("CombatEncounterDefenseRequestActor")
  targetDefenseRequests CombatEncounterDefenseRequest[]       @relation("CombatEncounterDefenseRequestTarget")
  actorDeclaredActions  CombatEncounterDeclaredAction[]       @relation("CombatEncounterDeclaredActionActor")
  targetDeclaredActions CombatEncounterDeclaredAction[]       @relation("CombatEncounterDeclaredActionTarget")
  actorEvents           CombatEncounterEvent[]                @relation("CombatEncounterEventActor")
  targetEvents          CombatEncounterEvent[]                @relation("CombatEncounterEventTarget")
  isActive              Boolean                               @default(true) @map("is_active")
  sortOrder             Int                                   @default(0) @map("sort_order")
  createdAt             DateTime                              @default(now()) @map("created_at")
  updatedAt             DateTime                              @updatedAt @map("updated_at")

  @@index([encounterId, sortOrder])
  @@index([playerCharacterId])
  @@index([creatureId])
  @@index([creatureTierId])
  @@map("combat_encounter_participants")
}

model CombatEncounterParticipantCondition {
  id                  String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId         String                         @map("encounter_id") @db.Uuid
  encounter           CombatEncounter                @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  participantId       String                         @map("participant_id") @db.Uuid
  participant         CombatEncounterParticipant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  conditionId         String                         @map("condition_id") @db.Uuid
  condition           Condition                      @relation(fields: [conditionId], references: [id], onDelete: Restrict)
  displayName         String?                        @map("display_name")
  level               Int                            @default(1)
  sourceParticipantId String?                        @map("source_participant_id") @db.Uuid
  sourceActionSlug    String?                        @map("source_action_slug")
  metadata            Json                           @default("{}")
  isActive            Boolean                        @default(true) @map("is_active")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  sourceLinks         CombatEncounterConditionLink[] @relation("CombatEncounterConditionLinkSourceInstance")
  targetLinks         CombatEncounterConditionLink[] @relation("CombatEncounterConditionLinkTargetInstance")

  @@index([encounterId, participantId, isActive])
  @@index([conditionId])
  @@index([sourceParticipantId])
  @@map("combat_encounter_participant_conditions")
}

model CombatEncounterConditionLink {
  id                        String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId               String                               @map("encounter_id") @db.Uuid
  encounter                 CombatEncounter                      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  sourceParticipantId       String                               @map("source_participant_id") @db.Uuid
  sourceParticipant         CombatEncounterParticipant           @relation("CombatEncounterConditionLinkSource", fields: [sourceParticipantId], references: [id], onDelete: Cascade)
  targetParticipantId       String                               @map("target_participant_id") @db.Uuid
  targetParticipant         CombatEncounterParticipant           @relation("CombatEncounterConditionLinkTarget", fields: [targetParticipantId], references: [id], onDelete: Cascade)
  sourceConditionId         String                               @map("source_condition_id") @db.Uuid
  sourceCondition           Condition                            @relation("CombatEncounterConditionLinkSourceCondition", fields: [sourceConditionId], references: [id], onDelete: Restrict)
  targetConditionId         String                               @map("target_condition_id") @db.Uuid
  targetCondition           Condition                            @relation("CombatEncounterConditionLinkTargetCondition", fields: [targetConditionId], references: [id], onDelete: Restrict)
  sourceConditionInstanceId String?                              @map("source_condition_instance_id") @db.Uuid
  sourceConditionInstance   CombatEncounterParticipantCondition? @relation("CombatEncounterConditionLinkSourceInstance", fields: [sourceConditionInstanceId], references: [id], onDelete: SetNull)
  targetConditionInstanceId String?                              @map("target_condition_instance_id") @db.Uuid
  targetConditionInstance   CombatEncounterParticipantCondition? @relation("CombatEncounterConditionLinkTargetInstance", fields: [targetConditionInstanceId], references: [id], onDelete: SetNull)
  sourceActionSlug          String?                              @map("source_action_slug")
  metadata                  Json                                 @default("{}")
  isActive                  Boolean                              @default(true) @map("is_active")
  createdAt                 DateTime                             @default(now()) @map("created_at")
  updatedAt                 DateTime                             @updatedAt @map("updated_at")

  @@index([encounterId, isActive])
  @@index([sourceParticipantId, isActive])
  @@index([targetParticipantId, isActive])
  @@index([sourceConditionId])
  @@index([targetConditionId])
  @@map("combat_encounter_condition_links")
}

model CombatEncounterDefenseRequest {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId         String                     @map("encounter_id") @db.Uuid
  encounter           CombatEncounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  actorParticipantId  String                     @map("actor_participant_id") @db.Uuid
  actorParticipant    CombatEncounterParticipant @relation("CombatEncounterDefenseRequestActor", fields: [actorParticipantId], references: [id], onDelete: Cascade)
  targetParticipantId String                     @map("target_participant_id") @db.Uuid
  targetParticipant   CombatEncounterParticipant @relation("CombatEncounterDefenseRequestTarget", fields: [targetParticipantId], references: [id], onDelete: Cascade)
  createdByUserId     String                     @map("created_by_user_id") @db.Uuid
  actionSlug          String                     @map("action_slug")
  actionSnapshot      Json                       @map("action_snapshot")
  attackRoll          Json                       @map("attack_roll")
  defenseOptions      Json                       @default("[]") @map("defense_options")
  status              String                     @default("pending")
  resolvedByUserId    String?                    @map("resolved_by_user_id") @db.Uuid
  resolvedAt          DateTime?                  @map("resolved_at")
  resolution          Json                       @default("{}")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  @@index([encounterId, status, createdAt])
  @@index([targetParticipantId, status])
  @@index([actorParticipantId])
  @@map("combat_encounter_defense_requests")
}

model CombatEncounterDeclaredAction {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId         String                      @map("encounter_id") @db.Uuid
  encounter           CombatEncounter             @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  actorParticipantId  String                      @map("actor_participant_id") @db.Uuid
  actorParticipant    CombatEncounterParticipant  @relation("CombatEncounterDeclaredActionActor", fields: [actorParticipantId], references: [id], onDelete: Cascade)
  targetParticipantId String?                     @map("target_participant_id") @db.Uuid
  targetParticipant   CombatEncounterParticipant? @relation("CombatEncounterDeclaredActionTarget", fields: [targetParticipantId], references: [id], onDelete: SetNull)
  createdByUserId     String                      @map("created_by_user_id") @db.Uuid
  actionSlug          String                      @map("action_slug")
  actionSnapshot      Json                        @map("action_snapshot")
  declaredAtPotential Int                         @map("declared_at_potential")
  resolveAtPotential  Int                         @map("resolve_at_potential")
  status              String                      @default("pending")
  resolvedByUserId    String?                     @map("resolved_by_user_id") @db.Uuid
  resolvedAt          DateTime?                   @map("resolved_at")
  resolution          Json                        @default("{}")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([encounterId, status, resolveAtPotential, createdAt])
  @@index([actorParticipantId, status])
  @@index([targetParticipantId, status])
  @@map("combat_encounter_declared_actions")
}

model CombatEncounterEvent {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId         String                      @map("encounter_id") @db.Uuid
  encounter           CombatEncounter             @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdByUserId     String                      @map("created_by_user_id") @db.Uuid
  actorParticipantId  String?                     @map("actor_participant_id") @db.Uuid
  actorParticipant    CombatEncounterParticipant? @relation("CombatEncounterEventActor", fields: [actorParticipantId], references: [id], onDelete: SetNull)
  targetParticipantId String?                     @map("target_participant_id") @db.Uuid
  targetParticipant   CombatEncounterParticipant? @relation("CombatEncounterEventTarget", fields: [targetParticipantId], references: [id], onDelete: SetNull)
  type                String
  actionSlug          String?                     @map("action_slug")
  payload             Json                        @default("{}")
  createdAt           DateTime                    @default(now()) @map("created_at")

  @@index([encounterId, createdAt])
  @@index([createdByUserId])
  @@index([actorParticipantId])
  @@index([targetParticipantId])
  @@map("combat_encounter_events")
}

model AuthSession {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  familyId     String        @db.Uuid
  parentId     String?       @db.Uuid
  parent       AuthSession?  @relation("AuthSessionRotation", fields: [parentId], references: [id], onDelete: SetNull)
  children     AuthSession[] @relation("AuthSessionRotation")
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?       @db.Uuid
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([parentId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model SkillCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  skills      Skill[]

  @@index([isActive, sortOrder])
  @@map("skill_categories")
}

model SkillLevel {
  id                    String   @id @default(uuid()) @db.Uuid
  level                 Int      @unique
  name                  String
  canRoll               Boolean  @default(true) @map("can_roll")
  successMin            Int?     @map("success_min")
  doubleSuccessMin      Int?     @map("double_success_min")
  ignoreOnesCount       Int      @default(0) @map("ignore_ones_count")
  expectedSuccessPerDie Decimal  @default(0) @map("expected_success_per_die") @db.Decimal(8, 4)
  ruleText              String?  @map("rule_text")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("skill_levels")
}

model Skill {
  id                             String                        @id @default(uuid()) @db.Uuid
  slug                           String                        @unique @default(cuid())
  name                           String
  shortName                      String?                       @map("short_name")
  categoryId                     String                        @map("category_id") @db.Uuid
  category                       SkillCategory                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description                    String?
  maxLevel                       Int                           @default(6) @map("max_level")
  defaultLevel                   Int                           @default(0) @map("default_level")
  usesDefaultLevelRules          Boolean                       @default(true) @map("uses_default_level_rules")
  systemValueId                  String                        @unique @map("system_value_id") @db.Uuid
  systemValue                    SystemValue                   @relation("SkillSystemValue", fields: [systemValueId], references: [id], onDelete: Restrict)
  rollCharacteristicId           String?                       @map("roll_characteristic_id") @db.Uuid
  rollCharacteristic             Characteristic?               @relation("SkillRollCharacteristic", fields: [rollCharacteristicId], references: [id], onDelete: SetNull)
  rollConsequenceId              String?                       @map("roll_consequence_id") @db.Uuid
  rollConsequence                RollConsequence?              @relation(fields: [rollConsequenceId], references: [id], onDelete: SetNull)
  magicWordLinks                 MagicWordSkillLink[]
  spellMechanicParameterDefaults SpellMechanicParameter[]
  creatureTierSkills             CreatureTierSkill[]
  weapons                        Weapon[]
  weaponAttackProfiles           WeaponAttackProfile[]
  weaponTemplates                WeaponTemplate[]
  weaponTemplateAttackProfiles   WeaponTemplateAttackProfile[]
  naturalAttacks                 NaturalAttack[]
  naturalAttackProfiles          NaturalAttackProfile[]
  isActive                       Boolean                       @default(true) @map("is_active")
  sortOrder                      Int                           @default(0) @map("sort_order")
  createdAt                      DateTime                      @default(now()) @map("created_at")
  updatedAt                      DateTime                      @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([rollCharacteristicId])
  @@index([rollConsequenceId])
  @@index([categoryId, isActive, sortOrder])
  @@map("skills")
}

model RollConsequence {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  rollEventGraph Json?    @map("roll_event_graph")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  skills         Skill[]

  @@index([isActive, sortOrder])
  @@map("roll_consequences")
}

model GameEventHandler {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type")
  name        String
  description String?
  graph       Json?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([eventType, isActive, sortOrder])
  @@map("game_event_handlers")
}

model MagicWord {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        MagicWordType
  slug        String        @default(cuid())
  name        String
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  modifierGestureRestrictions MagicWordGestureRestriction[] @relation("MagicModifierRestrictions")
  gestureModifierRestrictions MagicWordGestureRestriction[] @relation("MagicGestureRestrictions")
  skillLinks                  MagicWordSkillLink[]
  damageTypeLinks             MagicWordDamageTypeLink[]
  conditionLinks              MagicWordConditionLink[]
  essenceProfile              MagicWordEssenceProfile?
  areaShape                   AreaShape?
  actionSpells                Spell[]                       @relation("SpellAction")
  essenceSpells               Spell[]                       @relation("SpellEssence")
  gestureSpells               Spell[]                       @relation("SpellGesture")

  @@unique([type, name])
  @@unique([type, slug])
  @@index([type, isActive, sortOrder])
  @@map("magic_words")
}

model MagicWordEssenceProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  magicWordId       String    @unique @map("magic_word_id") @db.Uuid
  magicWord         MagicWord @relation(fields: [magicWordId], references: [id], onDelete: Cascade)
  damageAffinity    Decimal   @default(0.5) @map("damage_affinity") @db.Decimal(5, 4)
  rangeAffinity     Decimal   @default(0.5) @map("range_affinity") @db.Decimal(5, 4)
  controlAffinity   Decimal   @default(0.5) @map("control_affinity") @db.Decimal(5, 4)
  durationAffinity  Decimal   @default(0.5) @map("duration_affinity") @db.Decimal(5, 4)
  areaAffinity      Decimal   @default(0.5) @map("area_affinity") @db.Decimal(5, 4)
  stabilityAffinity Decimal   @default(0.5) @map("stability_affinity") @db.Decimal(5, 4)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([magicWordId])
  @@map("magic_word_essence_profiles")
}

model AreaShape {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gestureId       String        @unique @map("gesture_id") @db.Uuid
  gesture         MagicWord     @relation(fields: [gestureId], references: [id], onDelete: Cascade)
  kind            AreaShapeKind
  name            String
  description     String?
  dimensions      Json          @default("{}")
  influenceConfig Json          @default("{}") @map("influence_config")
  isActive        Boolean       @default(true) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([kind, isActive, sortOrder])
  @@index([gestureId])
  @@map("area_shapes")
}

model Spell {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionId       String               @map("action_id") @db.Uuid
  action         MagicWord            @relation("SpellAction", fields: [actionId], references: [id], onDelete: Restrict)
  essenceId      String               @map("essence_id") @db.Uuid
  essence        MagicWord            @relation("SpellEssence", fields: [essenceId], references: [id], onDelete: Restrict)
