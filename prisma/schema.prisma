generator client {
  provider = "prisma-client-js"
  output   = "./__generated__"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum SystemValueOwnerType {
  ATTRIBUTE
  CHARACTERISTIC
  SKILL
  ROLL_CONSEQUENCE
  MANUAL
}

enum MagicWordType {
  ACTION
  ESSENCE
  GESTURE
  MODIFIER
}

enum SpellStatus {
  DRAFT
  TESTING
  READY
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  username                String                   @unique
  displayUsername         String
  passwordHash            String
  role                    UserRole                 @default(USER)
  isActive                Boolean                  @default(true)
  isEmailVerified         Boolean                  @default(false)
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@map("users")
}

model AuthSession {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  familyId     String        @db.Uuid
  parentId     String?       @db.Uuid
  parent       AuthSession?  @relation("AuthSessionRotation", fields: [parentId], references: [id], onDelete: SetNull)
  children     AuthSession[] @relation("AuthSessionRotation")
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?       @db.Uuid
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([parentId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model SkillCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  skills      Skill[]

  @@index([isActive, sortOrder])
  @@map("skill_categories")
}

model SkillLevel {
  id                    String   @id @default(uuid()) @db.Uuid
  level                 Int      @unique
  name                  String
  canRoll               Boolean  @default(true) @map("can_roll")
  successMin            Int?     @map("success_min")
  doubleSuccessMin      Int?     @map("double_success_min")
  ignoreOnesCount       Int      @default(0) @map("ignore_ones_count")
  expectedSuccessPerDie Decimal  @default(0) @map("expected_success_per_die") @db.Decimal(8, 4)
  ruleText              String?  @map("rule_text")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("skill_levels")
}

model Skill {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  shortName             String?          @map("short_name")
  categoryId            String           @map("category_id") @db.Uuid
  category              SkillCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description           String?
  maxLevel              Int              @default(6) @map("max_level")
  defaultLevel          Int              @default(0) @map("default_level")
  usesDefaultLevelRules Boolean          @default(true) @map("uses_default_level_rules")
  systemValueId         String           @unique @map("system_value_id") @db.Uuid
  systemValue           SystemValue      @relation("SkillSystemValue", fields: [systemValueId], references: [id], onDelete: Restrict)
  rollCharacteristicId  String?          @map("roll_characteristic_id") @db.Uuid
  rollCharacteristic    Characteristic?   @relation("SkillRollCharacteristic", fields: [rollCharacteristicId], references: [id], onDelete: SetNull)
  rollConsequenceId     String?          @map("roll_consequence_id") @db.Uuid
  rollConsequence       RollConsequence? @relation(fields: [rollConsequenceId], references: [id], onDelete: SetNull)
  isActive              Boolean          @default(true) @map("is_active")
  sortOrder             Int              @default(0) @map("sort_order")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([rollCharacteristicId])
  @@index([rollConsequenceId])
  @@index([categoryId, isActive, sortOrder])
  @@map("skills")
}

model RollConsequence {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  rollEventGraph Json?    @map("roll_event_graph")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  skills      Skill[]

  @@index([isActive, sortOrder])
  @@map("roll_consequences")
}

model GameEventHandler {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type")
  name        String
  description String?
  graph       Json?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([eventType, isActive, sortOrder])
  @@map("game_event_handlers")
}

model MagicWord {
  id          String   @id @default(uuid()) @db.Uuid
  type        MagicWordType
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modifierGestureRestrictions MagicWordGestureRestriction[] @relation("MagicModifierRestrictions")
  gestureModifierRestrictions  MagicWordGestureRestriction[] @relation("MagicGestureRestrictions")
  actionSpells                 Spell[] @relation("SpellAction")
  essenceSpells                Spell[] @relation("SpellEssence")
  gestureSpells                Spell[] @relation("SpellGesture")

  @@unique([type, name])
  @@index([type, isActive, sortOrder])
  @@map("magic_words")
}

model Spell {
  id          String      @id @default(uuid()) @db.Uuid
  actionId    String      @map("action_id") @db.Uuid
  action      MagicWord   @relation("SpellAction", fields: [actionId], references: [id], onDelete: Restrict)
  essenceId   String      @map("essence_id") @db.Uuid
  essence     MagicWord   @relation("SpellEssence", fields: [essenceId], references: [id], onDelete: Restrict)
  gestureId   String      @map("gesture_id") @db.Uuid
  gesture     MagicWord   @relation("SpellGesture", fields: [gestureId], references: [id], onDelete: Restrict)
  name        String
  description String?
  status      SpellStatus @default(DRAFT)
  isActive    Boolean     @default(false) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([actionId, essenceId, gestureId])
  @@index([status, isActive, sortOrder])
  @@index([actionId])
  @@index([essenceId])
  @@index([gestureId])
  @@map("spells")
}

model MagicWordGestureRestriction {
  id         String    @id @default(uuid()) @db.Uuid
  modifierId String   @map("modifier_id") @db.Uuid
  modifier   MagicWord @relation("MagicModifierRestrictions", fields: [modifierId], references: [id], onDelete: Cascade)
  gestureId  String   @map("gesture_id") @db.Uuid
  gesture    MagicWord @relation("MagicGestureRestrictions", fields: [gestureId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([modifierId, gestureId])
  @@index([modifierId])
  @@index([gestureId])
  @@map("magic_word_gesture_restrictions")
}

model Attribute {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  systemValueId   String           @unique @map("system_value_id") @db.Uuid
  systemValue     SystemValue      @relation(fields: [systemValueId], references: [id], onDelete: Restrict)
  poolPenaltyValueId String?        @map("pool_penalty_value_id") @db.Uuid
  poolPenaltyValue   SystemValue?   @relation("AttributePoolPenaltyValue", fields: [poolPenaltyValueId], references: [id], onDelete: SetNull)
  availablePoolValueId String?      @unique @map("available_pool_value_id") @db.Uuid
  availablePoolValue   SystemValue? @relation("AttributeAvailablePoolValue", fields: [availablePoolValueId], references: [id], onDelete: SetNull)
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  characteristics Characteristic[]

  @@index([isActive, sortOrder])
  @@index([poolPenaltyValueId])
  @@map("attributes")
}

model Characteristic {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  attributeId   String      @map("attribute_id") @db.Uuid
  attribute     Attribute   @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  description   String?
  minValue      Int         @default(0) @map("min_value")
  maxValue      Int         @default(10) @map("max_value")
  defaultValue  Int         @default(0) @map("default_value")
  systemValueId String      @unique @map("system_value_id") @db.Uuid
  systemValue   SystemValue @relation(fields: [systemValueId], references: [id], onDelete: Restrict)
  rollSkills    Skill[]     @relation("SkillRollCharacteristic")
  isActive      Boolean     @default(true) @map("is_active")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([attributeId])
  @@index([attributeId, isActive, sortOrder])
  @@map("characteristics")
}

model SystemValue {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  primaryOwnerType SystemValueOwnerType @map("primary_owner_type")
  primaryOwnerId   String?              @map("primary_owner_id") @db.Uuid
  displaySection   String?              @map("display_section")
  calculationGraph Json?                @map("calculation_graph")
  isSystemManaged  Boolean              @default(false) @map("is_system_managed")
  isActive         Boolean              @default(true) @map("is_active")
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  skills          Skill[]           @relation("SkillSystemValue")
  attributes      Attribute[]
  poolPenaltyAttributes Attribute[] @relation("AttributePoolPenaltyValue")
  availablePoolAttributes Attribute[] @relation("AttributeAvailablePoolValue")
  characteristics Characteristic[]
  links           SystemValueLink[]

  @@index([primaryOwnerType, primaryOwnerId])
  @@index([isActive, sortOrder])
  @@map("system_values")
}

model SystemValueLink {
  id            String               @id @default(uuid()) @db.Uuid
  systemValueId String               @map("system_value_id") @db.Uuid
  systemValue   SystemValue          @relation(fields: [systemValueId], references: [id], onDelete: Cascade)
  targetType    SystemValueOwnerType @map("target_type")
  targetId      String?              @map("target_id") @db.Uuid
  label         String?
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@unique([systemValueId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([systemValueId])
  @@map("system_value_links")
}

model CharacterSheetSandboxDraft {
  key         String   @id
  inputValues Json     @map("input_values")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("character_sheet_sandbox_drafts")
}
